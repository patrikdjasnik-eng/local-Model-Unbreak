{
  "name": "model-unbreak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n API,UI -c auto \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:ui": "vite",
    "dev:api": "tsx watch backend/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "start:api": "node dist/backend/src/server.js",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build:ui"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6"
  }
}
